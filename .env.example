# Copy these into Easypanel → your app → Environment. Never commit real values.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
MAILBOX=research.smallcase@niveshaay.com
ANTHROPIC_API_KEY=

# Inbox sorter (Complaints / Queries)
# First run only: sort emails received from this time (UTC). Leave empty to start from "now".
START_FROM=
INTERVAL_MINUTES=5
MAX_PER_RUN=40
# Spending guards (Claude API)
DAILY_LIMIT=100
MONTHLY_BUDGET_USD=15

# Dashboard
# Password for the dashboard web page (required; use a long one). DASHBOARD_USER is optional.
DASHBOARD_PASSWORD=
DASHBOARD_USER=
# How often new mail is collected and the dashboard rebuilt, in hours
REFRESH_HOURS=24
# First run only: collect mail received after this time (UTC)
TRACKER_START=2026-07-01T00:00:00Z
